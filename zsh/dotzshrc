# 9. Workflow Functions

# Create a new note
# Usage: zknew "Title" [inbox|permanent|project]
zknew() {
    local title="${1:-$(date +%Y-%m-%d-%H%M%S)}"
    local folder="${2:-inbox}"
    local dir=""
    local type=""

    case "$folder" in
        inbox) dir="$VAULT_INBOX"; type="inbox" ;;
        permanent) dir="$VAULT_PERM"; type="permanent" ;;
        project) dir="$VAULT_PROJ"; type="project" ;;
        *) echo "Invalid folder: $folder. Use inbox, permanent, or project."; return 1 ;;
    esac

    local filename=$(echo "$title" | tr ' ' '-' | tr '[:upper:]' '[:lower:]').md
    local filepath="$dir/$filename"

    if [[ -f "$filepath" ]]; then
        echo "File exists: $filepath"
        hx "$filepath"
        return 0
    fi

    cat > "$filepath" <<EOF
---
type: $type
date: $(date +%Y-%m-%d)
tags: []
source: ""
links:
  - support: []
  - contradiction: []
---

# $title

## Core Idea
<!-- One clear, atomic statement. -->

## Elaboration
<!-- Expand on the idea. -->

## Connections
### Supports
- [[ ]]

### Contradicts
- [[ ]]

## Open Questions
<!-- Unresolved tensions. -->

## Source
<!-- Local file path or URL (No Zotero) -->
- 

EOF

    echo "Created: $filepath"
    hx "$filepath"
}

# Convert Inbox to Permanent
# Usage: zkconvert [filename]
zkconvert() {
    local file="${1:-$(basename $(ls -t $VAULT_INBOX/*.md 2>/dev/null | head -n1))}"
    local src="$VAULT_INBOX/$file"
    local dst="$VAULT_PERM/$file"

    if [[ ! -f "$src" ]]; then
        echo "File not found in Inbox: $src"
        return 1
    fi

    mv "$src" "$dst"
    sed -i 's/type: inbox/type: permanent/' "$dst"
    echo "Converted: $file -> Permanent"
    hx "$dst"
}

# Query backlinks
# Usage: zkbacklinks "Note Title"
zkbacklinks() {
    local title="$1"
    if [[ -z "$title" ]]; then
        echo "Usage: zkbacklinks \"Note Title\""
        return 1
    fi
    echo "Searching for backlinks to: $title"
    rg "\[\[$title\]\]" "$VAULT_ROOT" --heading --color=always
}

# Local AI Perturbation (Ollama)
# Usage: echo "text" | zkperturb
zkperturb() {
    echo "$1" | ollama run $OLLAMA_MODEL "Act as a legal scholar. Provide 3 non-obvious interpretations and 1 critique. Keep it concise."
}

# Upload to Proton Drive (Helper)
# Usage: zkupload "filename"
zkupload() {
    local file="${1:-$(basename $(ls -t $VAULT_INBOX/*.md 2>/dev/null | head -n1))}"
    local src="$VAULT_INBOX/$file"
    local dst="$VAULT_UPLOADS/$file"

    if [[ ! -f "$src" ]]; then
        echo "File not found: $src"
        return 1
    fi

    cp "$src" "$dst"
    echo "Copied to Proton staging: $dst"
    echo "Now upload '$file' to Proton Drive via web/app and share the link."
}

# Copy bootstrapping document to clipboard
zkbootstrap() {
    local doc="$VAULT_ROOT/00-Context-Bootstrapping.md"
    if [[ ! -f "$doc" ]]; then
        echo "Bootstrapping document not found: $doc"
        return 1
    fi
    cat "$doc" | xclip -selection clipboard 2>/dev/null || cat "$doc" | wl-copy 2>/dev/null || echo "Clipboard copy failed. Manual copy required."
    echo "Bootstrapping document copied to clipboard."
}

# 10. Completion Definitions
# shell completions
eval "$(pixi completion --shell zsh)"

# load direnv
eval "$(direnv hook zsh)"

_zknew() {
    _arguments \
        '1:note title:' \
        '2:folder:(inbox permanent project)'
}
compdef _zknew zknew

_zkconvert() {
    _arguments \
        '1:inbox file:_files -W $VAULT_INBOX -g "*.md"'
}
compdef _zkconvert zkconvert

_zkbacklinks() {
    _arguments \
        '1:note title:_files -W $VAULT_ROOT -g "*.md"'
}
compdef _zkbacklinks zkbacklinks

