# 1. Zinit Initialization
source "${ZINIT_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/zinit}/zinit.git/zinit.zsh"

# 2. Core Plugins
zinit light zdharma-continuum/fast-syntax-highlighting
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-completions

# 3. fzf-tab (Load AFTER zsh-completions)
zinit ice wait'0' lucid
zinit light Aloxaf/fzf-tab

# 4. Completions
autoload -Uz compinit && compinit

# 5. fzf-tab Configuration
zstyle ':completion:*' sort false
zstyle ':fzf-tab:complete:*:*' fzf-flags --height=50% --layout=reverse --border
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -1 --color=always $realpath'
zstyle ':fzf-tab:complete:hx:*' fzf-preview 'bat --color=always --style=numbers $realpath 2>/dev/null || cat $realpath'
zstyle ':fzf-tab:complete:zknew:*' fzf-preview 'bat --color=always --style=numbers $realpath 2>/dev/null || cat $realpath'
zstyle ':fzf-tab:*' switch-group ',' '.'

