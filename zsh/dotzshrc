# 9. Workflow Functions

zknew() {
    local title="${1:-$(date +%Y-%m-%d-%H%M%S)}"
    local folder="${2:-inbox}"
    local dir=""
    local type=""

    case "$folder" in
        inbox) dir="$ZK_INBOX"; type="inbox" ;;
        permanent) dir="$ZK_PERM"; type="permanent" ;;
        project) dir="$ZK_PROJ"; type="project" ;;
        *) echo "Invalid folder: $folder. Use inbox, permanent, or project."; return 1 ;;
    esac

    local filename=$(echo "$title" | tr ' ' '-' | tr '[:upper:]' '[:lower:]').md
    local filepath="$dir/$filename"

    if [[ -f "$filepath" ]]; then
        echo "File exists: $filepath"
        hx "$filepath"
        return 0
    fi

    cat > "$filepath" <<EOF
---
type: $type
date: $(date +%Y-%m-%d)
tags: []
zotero_key: ""
links:
  - support: []
  - contradiction: []
---

# $title

## Core Idea
<!-- One clear, atomic statement. -->

## Elaboration
<!-- Expand on the idea. -->

## Connections
### Supports
- [[ ]]

### Contradicts
- [[ ]]

## Open Questions
<!-- Unresolved tensions. -->

EOF

    echo "Created: $filepath"
    hx "$filepath"
}

zkconvert() {
    local file="${1:-$(basename $(ls -t $ZK_INBOX/*.md 2>/dev/null | head -n1))}"
    local src="$ZK_INBOX/$file"
    local dst="$ZK_PERM/$file"

    if [[ ! -f "$src" ]]; then
        echo "File not found in Inbox: $src"
        return 1
    fi

    mv "$src" "$dst"
    sed -i 's/type: inbox/type: permanent/' "$dst"
    echo "Converted: $file -> Permanent"
    hx "$dst"
}

zkbacklinks() {
    local title="$1"
    if [[ -z "$title" ]]; then
        echo "Usage: zkbacklinks \"Note Title\""
        return 1
    fi
    echo "Searching for backlinks to: $title"
    rg "\[\[$title\]\]" "$ZK_ROOT" --heading --color=always
}

zkperturb() {
    echo "$1" | ollama run $OLLAMA_MODEL "Act as a legal scholar. Provide 3 non-obvious interpretations and 1 critique. Keep it concise."
}

# 10. Completion Definitions for Custom Functions
# These enable fzf-tab to provide fuzzy completion for zk* commands
_zknew() {
    _arguments \
        '1:note title:' \
        '2:folder:(inbox permanent project)'
}
compdef _zknew zknew

_zkconvert() {
    _arguments \
        '1:inbox file:_files -W $ZK_INBOX -g "*.md"'
}
compdef _zkconvert zkconvert

_zkbacklinks() {
    _arguments \
        '1:note title:_files -W $ZK_ROOT -g "*.md"'
}
compdef _zkbacklinks zkbacklinks

